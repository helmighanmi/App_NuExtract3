# ---------------------------------------------------------------------------
# NuExtract3 Studio - environment variables
# Copy to `.env` and adjust. Every variable is prefixed with NUEXTRACT_.
# ---------------------------------------------------------------------------

# --- API server -------------------------------------------------------------
NUEXTRACT_ENVIRONMENT=local
NUEXTRACT_LOG_LEVEL=INFO
NUEXTRACT_API_HOST=0.0.0.0
NUEXTRACT_API_PORT=8080

# --- Inference backend ------------------------------------------------------
# auto         probe vLLM -> Ollama -> in-process Transformers (default)
# vllm         OpenAI-compatible vLLM server (GPU, or a remote endpoint)
# llamacpp     OpenAI-compatible llama.cpp server serving the GGUF build (CPU/GPU)
# ollama       local Ollama server (CPU/Metal/CUDA, easiest CPU setup)
# transformers in-process PyTorch (CPU/CUDA/MPS), requires the `local` extra
NUEXTRACT_PROVIDER=auto

# OpenAI-compatible endpoint used by vllm/llamacpp/auto
NUEXTRACT_MODEL_BASE_URL=http://localhost:8000/v1
NUEXTRACT_MODEL_API_KEY=EMPTY
NUEXTRACT_MODEL_NAME=numind/NuExtract3
NUEXTRACT_REQUEST_TIMEOUT_S=180
NUEXTRACT_MAX_RETRIES=2
NUEXTRACT_AUTO_PROBE_TIMEOUT_S=1.5

# --- Ollama (CPU-friendly GGUF) --------------------------------------------
NUEXTRACT_OLLAMA_BASE_URL=http://localhost:11434
# q4_k_m (3.4 GB, recommended) | q6_k (4.1 GB) | bf16 (9.3 GB)
NUEXTRACT_OLLAMA_MODEL=nuextract3:q4_k_m
# Context window; lower it to cut KV-cache RAM on CPU.
NUEXTRACT_OLLAMA_NUM_CTX=32768
# Used by docker-compose.cpu.yml for the Ollama container (server-wide).
NUEXTRACT_OLLAMA_CONTEXT_LENGTH=32768
NUEXTRACT_OLLAMA_KEEP_ALIVE=30m

# --- In-process Transformers backend ---------------------------------------
# auto | cpu | cuda | mps
NUEXTRACT_DEVICE=auto
# auto | float32 | bfloat16 | float16
NUEXTRACT_DTYPE=auto
# 0 = let PyTorch decide; try physical core count for CPU inference
NUEXTRACT_CPU_THREADS=0
# Cap generated tokens on local hardware (CPU decoding is slow)
NUEXTRACT_LOCAL_MAX_OUTPUT_TOKENS=4096
NUEXTRACT_TRUST_REMOTE_CODE=true

# Used only by docker-compose for the API container (host gateway). Keep
# localhost out of this one: inside a container, localhost is the container.
NUEXTRACT_DOCKER_MODEL_BASE_URL=http://host.docker.internal:8000/v1

# --- Document handling ------------------------------------------------------
NUEXTRACT_MAX_UPLOAD_MB=50
NUEXTRACT_MAX_PAGES=40
NUEXTRACT_DPI=200
NUEXTRACT_NATIVE_TEXT_MIN_CHARS=120
NUEXTRACT_PAGES_PER_REQUEST=8

# --- Generation -------------------------------------------------------------
NUEXTRACT_MAX_OUTPUT_TOKENS=16384
NUEXTRACT_TEMPERATURE=0.2
NUEXTRACT_THINKING_TEMPERATURE=0.6
NUEXTRACT_MARKDOWN_TEMPERATURE=1.0
NUEXTRACT_ENABLE_THINKING=false
NUEXTRACT_DEFAULT_TEMPLATE=invoice

# --- UI ---------------------------------------------------------------------
NUEXTRACT_API_BASE_URL=http://localhost:8080
