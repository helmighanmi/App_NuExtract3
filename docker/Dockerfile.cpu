# syntax=docker/dockerfile:1.7
# Self-contained CPU image: FastAPI + Streamlit + in-process Transformers.
#
# Use this when no model server is available (e.g. a CPU-only laptop or CI box).
# For the fastest CPU path, prefer docker-compose.cpu.yml, which runs Ollama with
# the quantized GGUF build and keeps this image lightweight.
#
# The model weights are downloaded on first use into HF_HOME. Mount a volume to
# keep them between restarts:
#   docker run -v hf-cache:/models/huggingface ...
FROM python:3.12-slim AS runtime

COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /uvx /bin/

# The CPU extra routes torch to download.pytorch.org/whl/cpu (no CUDA payload).
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    HF_HOME=/models/huggingface \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# libgomp1 is required by the CPU PyTorch wheels.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Dependency layer (cached unless pyproject/lock change).
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --extra cpu --no-install-project

# Application layer.
COPY src ./src
COPY apps ./apps
COPY configs ./configs
COPY eval ./eval
COPY scripts ./scripts
RUN uv sync --frozen --no-dev --extra cpu

# Non-root runtime user.
RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /models/huggingface \
    && chown -R appuser:appuser /app /models
USER appuser
ENV HOME=/home/appuser

EXPOSE 8080 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)"

CMD ["uvicorn", "nuextract_app.api.main:app", "--host", "0.0.0.0", "--port", "8080"]
